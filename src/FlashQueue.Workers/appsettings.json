{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReservationIngest": {
    "Capacity": 500
  },
  "ConnectionStrings": {
    "FlashQueueDb": "Host=localhost;Port=5432;Database=flashqueue;Username=flashqueue;Password=flashqueue"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "flashqueue",
    "Password": "flashqueue"
  },
  "ReservationRepository": {
    "TransientFaultMaxRetryAttempts": 3,
    "TransientFaultBaseDelay": "00:00:00.050"
  },
  "RabbitMqPublishResilience": {
    "PublishTimeout": "00:00:02",
    "ConsecutiveFailuresBeforeBreaking": 5,
    "SamplingDuration": "00:00:30",
    "BreakDuration": "00:00:30"
  },
  "_comment_Chaos": "El modo caos se activa con la variable de entorno CHAOS_MODE=true (no una clave de config); esta sección solo ajusta su intensidad si está activo. Ver docs/adr/0005-modo-caos.md.",
  "Chaos": {
    "MinLatency": "00:00:00.100",
    "MaxLatency": "00:00:02",
    "PostgresFailureProbability": 0.05,
    "RabbitMqFailureProbability": 0.10
  },
  "Observability": {
    "OtlpEndpoint": "http://localhost:4317"
  }
}
