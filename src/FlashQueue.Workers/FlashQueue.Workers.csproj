<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <UserSecretsId>dotnet-FlashQueue.Workers-b5431619-468f-47f6-b61f-9a023aebdc37</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- WebApplication/Minimal API: expone /health/dependencies (ADR 0004), /events/{id}/status
         (ADR 0008) y, desde ADR 0013, también la ingesta HTTP de FlashQueue.Api en el mismo
         proceso — un único ReservationIngestChannel compartido de verdad entre el productor
         (endpoint) y el consumidor (ReservationProcessingWorker, más abajo). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlashQueue.Api\FlashQueue.Api.csproj" />
    <ProjectReference Include="..\FlashQueue.Application\FlashQueue.Application.csproj" />
    <ProjectReference Include="..\FlashQueue.Infrastructure\FlashQueue.Infrastructure.csproj" />
    <ProjectReference Include="..\FlashQueue.Contracts\FlashQueue.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft.NET.Sdk.Worker no empaqueta wwwroot/ automáticamente como Sdk.Web (sin
         "static web assets") — se copia a mano para que dashboard.html llegue tanto a bin/ en
         local como a /app/publish en la imagen Docker. -->
    <Content Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
