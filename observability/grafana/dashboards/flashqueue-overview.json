{
  "title": "FlashQueue - Overview",
  "uid": "flashqueue-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "tags": ["flashqueue"],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Throughput de reservas procesadas (por segundo)",
      "description": "rate() del counter flashqueue.reservations.processed, desglosado por resultado (Confirmed/Rejected). Un Counter no da \"por segundo\" directamente — eso es lo que calcula rate() a partir del total acumulado.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(flashqueue_reservations_processed_total[1m])) by (reservation_status)",
          "legendFormat": "{{reservation_status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latencia de procesamiento end-to-end (p50 / p95 / p99)",
      "description": "Desde ReservationRequest.RequestedAt (cuando la Api aceptó la petición) hasta que la reserva queda resuelta en Postgres. histogram_quantile() sobre el histograma flashqueue.reservations.processing_duration.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 5 } },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(flashqueue_reservations_processing_duration_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(flashqueue_reservations_processing_duration_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum(rate(flashqueue_reservations_processing_duration_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Tamaño del channel de ingesta (ReservationIngestChannel)",
      "description": "ObservableGauge muestreado bajo demanda por el exportador de métricas. Api y Workers tienen cada uno su propia instancia de channel (ver docs/adr/0006), por eso se desglosa por service_name.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 15, "stacking": { "mode": "none" } }, "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "flashqueue_reservation_channel_size",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Reservas procesadas (total acumulado)",
      "description": "Valor absoluto del counter, no una tasa — para ver de un vistazo cuánto se ha procesado desde que arrancó el proceso.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Rejected" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Confirmed" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          }
        ]
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "horizontal", "colorMode": "value" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(flashqueue_reservations_processed_total) by (reservation_status)",
          "legendFormat": "{{reservation_status}}",
          "refId": "A"
        }
      ]
    }
  ]
}
